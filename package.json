{
  "name": "storzy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "preview:start": "powershell -ExecutionPolicy Bypass -File scripts/start-preview.ps1",
    "preview:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-preview.ps1",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/src/worker.js",
    "outbox": "tsx src/outbox-worker.ts",
    "start:outbox": "node dist/src/outbox-worker.js",
    "candidate": "tsx src/candidate-worker.ts",
    "start:candidate": "node dist/src/candidate-worker.js",
    "content": "tsx src/content-worker.ts",
    "start:content": "node dist/src/content-worker.js",
    "shopify": "tsx src/shopify-worker.ts",
    "mockup": "tsx src/mockup-worker.ts",
    "start:mockup": "node dist/src/mockup-worker.js",
    "printful-order": "tsx src/printful-order-worker.ts",
    "start:printful-order": "node dist/src/printful-order-worker.js",
    "shopify-fulfillment": "tsx src/shopify-fulfillment-worker.ts",
    "start:shopify-fulfillment": "node dist/src/shopify-fulfillment-worker.js",
    "start:shopify": "node dist/src/shopify-worker.js",
    "storefront": "tsx src/storefront-worker.ts",
    "start:storefront": "node dist/src/storefront-worker.js",
    "privacy-sla:scan": "tsx src/privacy-sla-scan.ts",
    "admin-auth:cleanup": "tsx src/admin-auth-retention-cleanup.ts",
    "start:admin-auth:cleanup": "node dist/src/admin-auth-retention-cleanup.js",
    "start:privacy-sla:scan": "node dist/src/privacy-sla-scan.js",
    "preview:privacy-sla:scan": "powershell -ExecutionPolicy Bypass -File scripts/scan-preview-privacy-sla.ps1",
    "privacy-alerts:deliver": "tsx src/privacy-alert-delivery.ts",
    "start:privacy-alerts:deliver": "node dist/src/privacy-alert-delivery.js",
    "shopify-token-alerts:deliver": "tsx src/shopify-token-alert-delivery.ts",
    "start:shopify-token-alerts:deliver": "node dist/src/shopify-token-alert-delivery.js",
    "order-reconciliation:scan": "tsx src/order-reconciliation-scan.ts",
    "deploy:preflight": "node --env-file-if-exists=.env --import tsx src/deployment-preflight.ts",
    "deploy:template": "node --import tsx src/deployment-template.ts",
    "deploy:kubernetes": "node --import tsx src/kubernetes-template.ts",
    "deploy:verify": "node --env-file-if-exists=.env --import tsx src/post-deploy-verify.ts",
    "providers:smoke": "node --env-file-if-exists=.env --import tsx src/provider-readonly-smoke.ts",
    "shopify:draft-smoke": "node --env-file-if-exists=.env --import tsx src/shopify-draft-smoke.ts",
    "printful:catalog-smoke": "node --env-file-if-exists=.env --import tsx src/printful-catalog-contract-smoke.ts",
    "start:order-reconciliation:scan": "node dist/src/order-reconciliation-scan.js",
    "outbox:dead-letters": "tsx src/outbox-admin.ts list",
    "outbox:requeue": "tsx src/outbox-admin.ts requeue",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:verify": "tsx src/db/verify-migrations.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/postgres-store.integration.test.ts",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "brand:mark": "tsx src/brand-mark.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "openai": "^7.4.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
