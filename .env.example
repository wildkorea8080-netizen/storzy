NODE_ENV=development
PORT=3000
# Production requires a public HTTPS origin without credentials, query, or hash.
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
DATABASE_URL=postgresql://storzy:storzy@localhost:5432/storzy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
GENERATION_LEASE_SECONDS=120
GENERATION_MAX_ATTEMPTS=4
WORKER_POLL_MS=1000
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_MS=1000
CANDIDATE_LEASE_SECONDS=120
CANDIDATE_MAX_ATTEMPTS=4
CANDIDATE_POLL_MS=1000
SHOPIFY_API_VERSION=2026-07
# 실제 draft 쓰기 smoke 실행 때만 대상 개발 스토어 도메인으로 설정
SHOPIFY_WRITE_SMOKE_CONFIRM=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ORDER_WORKSPACE_ID=
SHOPIFY_OAUTH_CALLBACK_URL=http://localhost:3000/api/integrations/shopify/oauth/callback
SHOPIFY_SCOPES=write_products,write_content,read_orders
SHOPIFY_FULFILLMENT_MAX_ATTEMPTS=8
ADMIN_API_TOKEN=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_AUTH_EVENT_RETENTION_DAYS=90
ADMIN_SESSION_RECORD_RETENTION_DAYS=30
ADMIN_SECURITY_ALERT_WEBHOOK_URL=
ADMIN_SECURITY_ALERT_WEBHOOK_SECRET=
PRINTFUL_API_BASE_URL=https://api.printful.com
PROVIDER_SMOKE_TIMEOUT_MS=10000
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_CATALOG_SMOKE_PRODUCT_ID=1
PRINTFUL_CATALOG_SMOKE_CURRENCY=USD
# At least 32 random bytes encoded as hexadecimal (64+ characters).
PRINTFUL_WEBHOOK_SECRET_HEX=
PRINTFUL_WEBHOOK_PUBLIC_KEY=
PRINTFUL_ORDER_MAX_ATTEMPTS=8
PRINTFUL_CATALOG_SEEDS_JSON=[]

# 32 random bytes encoded as base64. Keep in an operating-system or cloud secret manager.
INTEGRATION_CREDENTIAL_KEY_BASE64=
INTEGRATION_CREDENTIAL_KEY_VERSION=v1
ORDER_ALLOWED_COUNTRIES=US,JP
ORDER_MAX_AMOUNT_MINOR=50000
ORDER_MAX_ITEM_COUNT=10
ORDER_MAX_COST_INCREASE_BPS=1000
PREVIEW_UPLOAD_DIRECTORY=.preview/uploads
PREVIEW_UPLOAD_MAX_FILES=100
PREVIEW_UPLOAD_MAX_BYTES=524288000
PRIVACY_ALERT_WEBHOOK_URL=
PRIVACY_ALERT_WEBHOOK_SECRET=
PRIVACY_ALERT_MAX_ATTEMPTS=6
PRIVACY_ALERT_LEASE_SECONDS=30
PRIVACY_ALERT_BATCH_SIZE=20
